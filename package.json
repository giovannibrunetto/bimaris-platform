{
  "name": "bimaris-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "dev:web": "pnpm --filter @bimaris/web dev",
    "dev:mobile": "pnpm --filter @bimaris/mobile start",
    "build:web": "pnpm --filter @bimaris/web build",
    "lint:web": "pnpm --filter @bimaris/web lint",
    "typecheck:web": "pnpm --filter @bimaris/web exec tsc --noEmit",
    "typecheck:mobile": "pnpm --filter @bimaris/mobile exec tsc --noEmit",
    "check": "pnpm lint:web && pnpm typecheck:web && pnpm typecheck:mobile && pnpm test:auth && pnpm test:media",
    "test:auth": "node --experimental-strip-types --test apps/web/tests/auth-redirect.test.mjs apps/web/tests/admin-oauth-shared-callback.test.mjs apps/web/tests/admin-origin-guard.test.mjs apps/web/tests/admin-origin-runtime.test.mjs apps/web/tests/admin-policy.test.mjs apps/web/tests/api-rate-limit.test.mjs apps/web/tests/admin-mfa-regression.test.mjs apps/web/tests/admin-integration-regression.test.mjs apps/web/tests/mfa-smoke-context.test.mjs apps/web/tests/admin-mfa-guard-runtime.test.mjs apps/web/tests/admin-operators-runtime.test.mjs apps/web/tests/operator-origin-guard.test.mjs apps/web/tests/operator-origin-runtime.test.mjs apps/web/tests/admin-oauth-callback-staging.test.mjs apps/web/tests/operator-application-vat.test.mjs",
    "test:media": "node --experimental-strip-types --test apps/web/tests/experience-media-persistence.test.mjs"
  }
}
